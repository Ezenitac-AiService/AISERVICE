# ==============================================================================
# Model Gateway Environment Configuration Template (SSOT)
# ==============================================================================
# Mode: DEMO | Platform: dev-rtx3060 (RTX 3060 12GB, sm_86, AVX2)

APP_RUN_MODE=DEMO
PLATFORM_PROFILE=dev-rtx3060
CUDA_VISIBLE_DEVICES=0
CUDA_ARCH=86

# Ports
MAIN_PORT=8081
EMBEDDING_PORT=8090
RERANK_PORT=8091

# Model Inventory
DEFAULT_MODEL=qwen3.5-4b
FAST_LLM_MODEL=qwen3.5-2b
SYNTHESIS_LLM_MODEL=qwen3.5-4b
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3

# VRAM & Slot Safety
VRAM_SAFETY_LIMIT_MB=10240
MAX_GPU_CONCURRENT_SLOTS=4
QUEUE_TIMEOUT_SECONDS=60

# Redis State Store
REDIS_HOST=redis
REDIS_PORT=6379
