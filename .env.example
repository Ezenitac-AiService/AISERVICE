# AISERVICE Unified Environment Configuration
# ==========================================

# Gateway Configuration (Dual Port: 80 & 8080)
GATEWAY_PORT=80
GATEWAY_ALT_PORT=8080

# Model Gateway Internal DNS & Ports
SERVER_HOST=http://vllm-serv-gateway
MAIN_PORT=8081
EMBEDDING_PORT=8090
RERANK_PORT=8091
LLM_BASE_URL=http://vllm-serv-gateway:8081/v1
EMBEDDING_BASE_URL=http://vllm-serv-gateway:8090/v1
RERANK_BASE_URL=http://vllm-serv-gateway:8091/v1

# Multi-Tier LLM Models
FAST_LLM_MODEL=qwen3.5-2b
SYNTHESIS_LLM_MODEL=qwen3.5-4b
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3

# A-Team Pipeline Worker
PIPELINE_INTERVAL_SECONDS=600

# A-Team MySQL Database (Internal DNS: pilos-db:3306)
PILOS_DB_HOST=pilos-db
PILOS_DB_PORT=3306
PILOS_DB_NAME=pilos_v2
PILOS_DB_USER=pilos_user
PILOS_DB_PASSWORD=pilos_password
PILOS_DB_ROOT_PASSWORD=pilos_root_pass

# B-Team MySQL Database (Internal DNS: bteam_db:3306)
BTEAM_DB_HOST=bteam_db
BTEAM_DB_PORT=3306
BTEAM_DB_NAME=oliview_project
BTEAM_DB_USER=gp123
BTEAM_DB_PASSWORD=GP123!
BTEAM_DB_ROOT_PASSWORD=GP123!

# B-Team Backend (Internal DNS: oliview_backend:5050)
FLASK_APP_SECRET=oliview_secret_key_2026

# SMTP Configuration (Gmail 587)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sub-path Prefixes
STREAMLIT_SERVER_BASE_URL_PATH=bteam/chata
FASTAPI_ROOT_PATH=/bteam/chatb
