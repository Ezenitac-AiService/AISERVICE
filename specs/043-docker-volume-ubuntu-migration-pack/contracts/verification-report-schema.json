{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationReport",
  "type": "object",
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "DEGRADED" } } },
      "then": { "required": ["degraded_reason"] }
    }
  ],
  "required": [
    "timestamp",
    "status",
    "total_endpoints",
    "passed_endpoints",
    "failed_endpoints",
    "results"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["PASS", "DEGRADED", "FAIL"] },
    "degraded_reason": { "type": "string", "minLength": 1 },
    "total_endpoints": { "type": "integer" },
    "passed_endpoints": { "type": "integer" },
    "failed_endpoints": { "type": "integer" },
    "duration_seconds": { "type": "number" },
    "hardware_detected": {
      "type": "object",
      "properties": {
        "cpu_model": { "type": "string" },
        "avx_supported": { "type": "boolean" },
        "gpu_model": { "type": "string" },
        "vram_mb": { "type": "integer" },
        "compute_capability": { "type": "string" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "status_code", "latency_ms", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "status_code": { "type": "integer" },
          "latency_ms": { "type": "number" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "error": { "type": "string" }
        }
      }
    },
    "data_integrity": {
      "type": "object",
      "description": "복원 후 DB 행 수와 canonical Chroma vector 수의 원본 측정값 비교 결과"
    }
  }
}
