{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatApiRequestContract",
  "description": "Validated request contract for ChatA and ChatB",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "persona": {
      "type": "string",
      "enum": ["CONCIERGE", "ANALYST"],
      "default": "CONCIERGE"
    },
    "document_score_threshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.85
    },
    "cliff_delta": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.9,
      "default": 0.25
    },
    "brand_filter": {
      "type": "string",
      "maxLength": 120
    },
    "sentiment_filter": {
      "type": "string",
      "enum": ["ALL", "POSITIVE", "NEGATIVE", "NEUTRAL"],
      "default": "ALL"
    },
    "max_selected_reviews": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 6
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "default": 1024
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000,
      "default": 20000
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
