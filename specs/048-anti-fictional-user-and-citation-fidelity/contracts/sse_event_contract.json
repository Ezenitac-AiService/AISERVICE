{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatSseEventContract",
  "description": "Discriminated application payload carried by a UTF-8 text/event-stream event. Sequence monotonicity and reconnect replay rules are verified by integration tests.",
  "oneOf": [
    { "$ref": "#/$defs/startEvent" },
    { "$ref": "#/$defs/deltaEvent" },
    { "$ref": "#/$defs/citationEvent" },
    { "$ref": "#/$defs/productLinkEvent" },
    { "$ref": "#/$defs/pipelineStageEvent" },
    { "$ref": "#/$defs/abstentionEvent" },
    { "$ref": "#/$defs/doneEvent" },
    { "$ref": "#/$defs/errorEvent" }
  ],
  "$defs": {
    "baseProperties": {
      "request_id": { "type": "string", "format": "uuid" },
      "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
      "sequence": { "type": "integer", "minimum": 0 }
    },
    "startEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "start" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at"],
          "properties": { "started_at": { "type": "string", "format": "date-time" } }
        }
      }
    },
    "deltaEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "delta" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string", "maxLength": 20000 } }
        }
      }
    },
    "citationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "citation" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_index", "review_id", "display_quote", "quote_redacted"],
          "properties": {
            "review_index": { "type": "integer", "minimum": 1, "maximum": 20 },
            "review_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "display_quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Exact source substring when safe, otherwise the server-side exact-matched substring after the shared redaction policy."
            },
            "quote_redacted": { "type": "boolean" }
          }
        }
      }
    },
    "productLinkEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "product_link" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "url", "host_validated"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://([A-Za-z0-9-]+\\.)*oliveyoung\\.co\\.kr(?:/|$)"
            },
            "host_validated": { "const": true }
          }
        }
      }
    },
    "pipelineStageEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "pipeline_stage" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "status", "latency_ms"],
          "properties": {
            "stage": { "type": "string", "enum": ["search", "rerank", "grounding", "synthesis"] },
            "status": { "type": "string", "enum": ["pending", "running", "completed", "skipped", "failed"] },
            "latency_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "abstentionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "abstention" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "enum": ["NO_EVIDENCE", "POLICY_BLOCKED", "GROUNDING_FAILED"] },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    },
    "doneEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "done" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "k_bound", "model_invoked"],
          "properties": {
            "status": { "type": "string", "enum": ["answered", "abstained"] },
            "k_bound": { "type": "integer", "minimum": 0, "maximum": 20 },
            "model_invoked": { "type": "boolean" },
            "completed_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "errorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event_id", "sequence", "event", "data"],
      "properties": {
        "request_id": { "$ref": "#/$defs/baseProperties/request_id" },
        "event_id": { "$ref": "#/$defs/baseProperties/event_id" },
        "sequence": { "$ref": "#/$defs/baseProperties/sequence" },
        "event": { "const": "error" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "enum": ["UNAUTHORIZED", "FORBIDDEN", "RATE_LIMITED", "INVALID_REQUEST", "TIMEOUT", "UPSTREAM_ERROR", "INTERNAL_ERROR"]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
