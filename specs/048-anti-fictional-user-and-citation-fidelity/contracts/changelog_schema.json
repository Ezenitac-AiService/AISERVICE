{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangelogSchema",
  "description": "Schema for subsystem changelog entries in changelog.html",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "subsystem", "stage", "date", "title", "highlights"],
    "properties": {
      "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-(alpha|beta)$" },
      "subsystem": {
        "type": "string",
        "enum": ["chat_a", "chat_b", "model_gateway", "nginx_gateway", "oliview_web", "core", "pilos"]
      },
      "stage": {
        "type": "string",
        "enum": ["beta", "alpha"]
      },
      "date": { "type": "string", "format": "date" },
      "title": { "type": "string", "minLength": 1, "maxLength": 160 },
      "highlights": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "spec_ref": { "type": "string" }
    }
  }
}
