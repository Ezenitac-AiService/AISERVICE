{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature048RuntimeEnvironmentContract",
  "description": "Feature-owned environment subset consumed by Pydantic Settings and the Nginx template renderer. Secret fields hold references, never secret material.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "APP_RUN_MODE",
    "GATEWAY_PORT",
    "GATEWAY_ALT_PORT",
    "CHATBOT_A_PORT",
    "CHATBOT_B_PORT",
    "LLM_BASE_URL",
    "EMBEDDING_BASE_URL",
    "RERANK_BASE_URL",
    "REDIS_ENDPOINT",
    "CHAT_BEARER_SECRET_REF",
    "CHAT_SESSION_COOKIE_NAME",
    "CHAT_SESSION_TTL_SECONDS",
    "CHAT_CSRF_HEADER_NAME",
    "CHAT_RATE_LIMIT_REQUESTS",
    "CHAT_RATE_LIMIT_WINDOW_SECONDS",
    "CHAT_SERVICE_CONCURRENCY",
    "CHAT_QUERY_MAX_CHARS",
    "CHAT_OUTPUT_TOKEN_CAP",
    "CHAT_TIMEOUT_MS"
  ],
  "properties": {
    "APP_RUN_MODE": { "type": "string", "enum": ["DEMO", "PRODUCTION"] },
    "GATEWAY_PORT": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "GATEWAY_ALT_PORT": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "CHATBOT_A_PORT": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "CHATBOT_B_PORT": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "LLM_BASE_URL": { "type": "string", "format": "uri" },
    "EMBEDDING_BASE_URL": { "type": "string", "format": "uri" },
    "RERANK_BASE_URL": { "type": "string", "format": "uri" },
    "REDIS_ENDPOINT": { "type": "string", "format": "uri" },
    "ENABLE_EXTERNAL_VLLM": { "type": "boolean", "default": false },
    "CHAT_BEARER_SECRET_REF": { "type": "string", "minLength": 1 },
    "CHAT_SESSION_COOKIE_NAME": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "CHAT_SESSION_TTL_SECONDS": { "type": "integer", "minimum": 60 },
    "CHAT_CSRF_HEADER_NAME": { "type": "string", "pattern": "^X-[A-Za-z0-9-]+$" },
    "CHAT_RATE_LIMIT_REQUESTS": { "type": "integer", "minimum": 1 },
    "CHAT_RATE_LIMIT_WINDOW_SECONDS": { "type": "integer", "minimum": 1 },
    "CHAT_SERVICE_CONCURRENCY": { "type": "integer", "minimum": 1 },
    "CHAT_CONCURRENCY_LEASE_TTL_SECONDS": { "type": "integer", "minimum": 1 },
    "CHAT_QUERY_MAX_CHARS": { "type": "integer", "minimum": 1 },
    "CHAT_OUTPUT_TOKEN_CAP": { "type": "integer", "minimum": 1 },
    "CHAT_TIMEOUT_MS": { "type": "integer", "minimum": 1000 },
    "DEMO_ZERO_SEARCH_SLA_MS": { "type": "integer", "minimum": 1 },
    "DEMO_RAG_SLA_MS": { "type": "integer", "minimum": 1 },
    "PRODUCTION_TTFT_P95_MS": { "type": "integer", "minimum": 1 },
    "PRODUCTION_FULL_RESPONSE_P95_MS": { "type": "integer", "minimum": 1 },
    "PRODUCTION_AGGREGATE_TPS_MIN": { "type": "number", "exclusiveMinimum": 0 }
  }
}
