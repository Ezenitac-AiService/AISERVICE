{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatApiResponseContract",
  "description": "Final non-streaming or completed-stream response contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "status", "answer", "k_bound", "citations", "model_invoked"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["answered", "abstained", "error"] },
    "answer": { "type": "string", "maxLength": 20000 },
    "k_bound": { "type": "integer", "minimum": 0, "maximum": 20 },
    "model_invoked": { "type": "boolean" },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_index", "review_id", "display_quote", "quote_redacted"],
        "properties": {
          "review_index": { "type": "integer", "minimum": 1, "maximum": 20 },
          "review_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "display_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Exact source substring when safe, otherwise the server-side exact-matched substring after the shared redaction policy."
          },
          "quote_redacted": { "type": "boolean" }
        }
      }
    },
    "product_links": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url", "host_validated"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://([A-Za-z0-9-]+\\.)*oliveyoung\\.co\\.kr(?:/|$)"
          },
          "host_validated": { "const": true }
        }
      }
    },
    "pipeline_stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/searchStage" },
        { "$ref": "#/$defs/rerankStage" },
        { "$ref": "#/$defs/groundingStage" },
        { "$ref": "#/$defs/synthesisStage" }
      ],
      "items": false
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["UNAUTHORIZED", "FORBIDDEN", "RATE_LIMITED", "INVALID_REQUEST", "TIMEOUT", "UPSTREAM_ERROR", "INTERNAL_ERROR"]
        },
        "message": { "type": "string", "maxLength": 500 }
      }
    }
  },
  "$defs": {
    "stageStatus": { "type": "string", "enum": ["pending", "running", "completed", "skipped", "failed"] },
    "searchStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "latency_ms"],
      "properties": {
        "stage": { "const": "search" },
        "status": { "$ref": "#/$defs/stageStatus" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "rerankStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "latency_ms"],
      "properties": {
        "stage": { "const": "rerank" },
        "status": { "$ref": "#/$defs/stageStatus" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "groundingStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "latency_ms"],
      "properties": {
        "stage": { "const": "grounding" },
        "status": { "$ref": "#/$defs/stageStatus" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "synthesisStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "latency_ms"],
      "properties": {
        "stage": { "const": "synthesis" },
        "status": { "$ref": "#/$defs/stageStatus" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "answered" } }, "required": ["status"] },
      "then": {
        "required": ["product_links", "pipeline_stages"],
        "properties": {
          "answer": { "minLength": 1 },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "abstained" } }, "required": ["status"] },
      "then": {
        "required": ["pipeline_stages"],
        "properties": {
          "answer": { "minLength": 1 },
          "citations": { "maxItems": 0 },
          "product_links": { "maxItems": 0 },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": {
        "required": ["error"],
        "properties": {
          "answer": { "maxLength": 0 },
          "citations": { "maxItems": 0 },
          "product_links": { "maxItems": 0 },
          "error": { "type": "object" }
        }
      }
    }
  ]
}
