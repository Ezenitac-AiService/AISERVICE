worker_processes auto;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # WebSocket Upgrade Mapping
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Scheme detection with reverse proxy support
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    # Structured JSON Access Log Format with Request ID and Latency Tracing
    log_format json_analytics escape=json '{'
        '"time_local":"$time_local",'
        '"remote_addr":"$remote_addr",'
        '"request_id":"$request_id",'
        '"request_method":"$request_method",'
        '"request_uri":"$request_uri",'
        '"status":$status,'
        '"body_bytes_sent":$body_bytes_sent,'
        '"request_time":$request_time,'
        '"upstream_response_time":"$upstream_response_time",'
        '"upstream_addr":"$upstream_addr",'
        '"http_user_agent":"$http_user_agent"'
    '}';

    access_log /var/log/nginx/access.log json_analytics;
    error_log /var/log/nginx/error.log warn;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Docker Embedded DNS Server
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Global Max Body Size
    client_max_body_size 100M;

    # Gzip Compression
    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    server {
        listen ${GATEWAY_PORT};
        listen [::]:${GATEWAY_PORT};
        listen ${GATEWAY_ALT_PORT};
        listen [::]:${GATEWAY_ALT_PORT};
        server_name ${GATEWAY_SERVER_NAMES};

        # Standard Proxy Headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $request_id;
        proxy_redirect off;
        port_in_redirect off;

        # 1. Root Path - Unified Portal Landing Page
        location = / {
            root /usr/share/nginx/html;
            try_files /index.html =404;
            add_header Cache-Control "no-store, no-cache, must-revalidate";
        }

        # Canonical Changelog Data JSON
        location = /changelog_data.json {
            root /usr/share/nginx/html;
            try_files /changelog_data.json =404;
            default_type application/json;
            add_header Cache-Control "no-store, no-cache, must-revalidate";
        }

        # Canonical Changelog Path
        location /changelog {
            root /usr/share/nginx/html;
            try_files /changelog.html =404;
            default_type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate";
        }

        # 2. B-Team Oliview Backend API
        location ^~ /bteam/oliview/api/ {
            proxy_pass ${OLIVIEW_BACKEND_UPSTREAM}/api/;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;

            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Request-ID" always;
            add_header Access-Control-Allow-Credentials "true" always;

            if ($request_method = 'OPTIONS') {
                return 204;
            }
        }

        # 3. B-Team Oliview Main Frontend
        location /bteam/oliview/ {
            proxy_pass ${OLIVIEW_FRONTEND_UPSTREAM};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location = /bteam/oliview {
            return 301 /bteam/oliview/;
        }

        # 4. B-Team Oliview Chatbot A
        location /bteam/chata/ {
            proxy_pass ${CHATBOT_A_UPSTREAM}/;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Prefix /bteam/chata;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location = /bteam/chata {
            return 301 /bteam/chata/;
        }

        # 5. B-Team Oliview Chatbot B
        location /bteam/chatb/ {
            proxy_pass ${CHATBOT_B_UPSTREAM}/;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Prefix /bteam/chatb;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location = /bteam/chatb {
            return 301 /bteam/chatb/;
        }

        # 6. A-Team Pilos Main Web Dashboard
        location /ateam/pilos/ {
            proxy_pass ${PILOS_WEB_UPSTREAM}/;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Prefix /ateam/pilos;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location = /ateam/pilos {
            return 301 /ateam/pilos/;
        }

        # Pilos Frontend /api/ direct proxy
        location /api/ {
            proxy_pass ${PILOS_WEB_UPSTREAM};
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # Pilos Frontend /stocks/ direct proxy
        location /stocks/ {
            proxy_pass ${PILOS_WEB_UPSTREAM}/stocks/;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location = /stocks {
            return 301 /stocks/;
        }

        # Pilos Frontend /about direct proxy
        location /about {
            proxy_pass ${PILOS_WEB_UPSTREAM}/about;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # Static Assets Direct Proxy
        location /static/ {
            proxy_pass ${PILOS_WEB_UPSTREAM}/static/;
            proxy_http_version 1.1;
            proxy_buffering on;
            add_header Cache-Control "public, max-age=86400" always;
            expires 1d;
        }

        # Error Pages
        error_page 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
            internal;
        }
    }
}
