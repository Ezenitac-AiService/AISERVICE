# ==============================================================================
# AISERVICE Migration Pack Environment Template (SSOT)
# ==============================================================================
# Used by bootstrap_restore.py to configure Ubuntu 24.04 LTS native target.
# Passwords and secrets must be injected from external protected files.

# 1. Operational Mode
APP_RUN_MODE=DEMO

# 2. Host Gateway Binding Ports (5 Tunnel Entry Points)
GATEWAY_PORTAL_PORT=3000
GATEWAY_PILOS_PORT=8001
GATEWAY_OLIVIEW_PORT=8002
GATEWAY_CHATA_PORT=8003
GATEWAY_CHATB_PORT=8004

# 3. Hardware Profile
PLATFORM_PROFILE=dev-rtx3060
CUDA_VISIBLE_DEVICES=0
CUDA_ARCH=86

# 4. Model Gateway Internal Endpoints & SSOT Model Routing
SERVER_HOST=http://vllm-serv-gateway
MAIN_PORT=8081
EMBEDDING_PORT=8090
RERANK_PORT=8091
LLM_BASE_URL=http://vllm-serv-gateway:8081/v1
EMBEDDING_BASE_URL=http://vllm-serv-gateway:8090/v1
RERANK_BASE_URL=http://vllm-serv-gateway:8091/v1

DEFAULT_MODEL=qwen3.5-4b
FAST_LLM_MODEL=qwen3.5-2b
SYNTHESIS_LLM_MODEL=qwen3.5-4b
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3
REPORT_LLM_OUTPUT_MODE=json_object

# 5. VRAM Protection & Capacity Policy
VRAM_SAFETY_LIMIT_MB=10240
MAX_GPU_CONCURRENT_SLOTS=4
QUEUE_TIMEOUT_SECONDS=60

# 6. Rate Limiting & Anonymous Traffic Control
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_CONCURRENT_REQUESTS=2
RATE_LIMIT_MAX_BODY_BYTES=65536
RATE_LIMIT_MAX_RESPONSE_TOKENS=16384
RATE_LIMIT_TIMEOUT_SECONDS=180
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# 7. Reverse Tunnel Settings
ENABLE_SSH_STANDBY_TUNNEL=false

# 8. Redis State Store
REDIS_HOST=redis
REDIS_PORT=6379

# 9. A-Team MySQL Database (Internal Network: pilos-db:3306)
PILOS_DB_HOST=pilos-db
PILOS_DB_PORT=3306
PILOS_DB_NAME=pilos_v2
PILOS_DB_USER=pilos_user
PILOS_DB_PASSWORD=__SET_IN_PROTECTED_SECRETS_FILE__
PILOS_DB_ROOT_PASSWORD=__SET_IN_PROTECTED_SECRETS_FILE__

# 10. A-Team Pipeline Worker
PIPELINE_INTERVAL_SECONDS=600

# 11. B-Team MySQL Database (Internal Network: bteam_db:3306)
BTEAM_DB_HOST=bteam_db
BTEAM_DB_PORT=3306
BTEAM_DB_NAME=oliview_project
BTEAM_DB_USER=bteam_user
BTEAM_DB_PASSWORD=__SET_IN_PROTECTED_SECRETS_FILE__
BTEAM_DB_ROOT_PASSWORD=__SET_IN_PROTECTED_SECRETS_FILE__

# 12. B-Team Backend (Internal Network: oliview_backend:5050)
FLASK_APP_SECRET=__SET_IN_PROTECTED_SECRETS_FILE__

# 13. Sub-path Prefixes
PORTAL_ROOT_PATH=/
STREAMLIT_SERVER_BASE_URL_PATH=bteam/chata
FASTAPI_ROOT_PATH=/bteam/chatb
