# =================================================================
# A-Team Containerized Environment Configuration
# =================================================================
# Copy this file to .env and fill local secrets/endpoints.
# Never commit .env to Git.

# --- Host Port Mapping (B-Team 포트 충돌 방지) ---
HOST_WEB_PORT=8080
HOST_DB_PORT=3307
WEB_PORT=8080

# --- Flask Web Application ---
FLASK_SECRET_KEY=dev_secret_key_change_in_prod
PORT=5000

# --- MySQL Connection (Internal Docker Network) ---
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pilos_password
DB_NAME=pilos_v2
DB_ROOT_PASSWORD=pilos_root_pass

# --- De-identification Hashing Salts ---
SECRET_SALT=pilos_sentiment_salt_1
SECRET_SALT2=pilos_sentiment_salt_2

# --- Kiwoom Supply-Demand (Optional) ---
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_START_DATE=
KIWOOM_END_DATE=
SUPPLY_DEMAND_DB_WRITE_ENABLED=false

# --- Shared OpenAI-compatible LLM Connection (aiservice-network) ---
LLM_PROVIDER=openai
LLM_BASE_URL=http://llm-server:8000/v1
LLM_API_KEY=EMPTY

# Chatbot LLM
CHAT_LLM_MODEL=qwen2.5-14b-instruct
CHAT_LLM_TIMEOUT_SECONDS=120

# LLM Report Generation
REPORT_LLM_MODEL=qwen2.5-14b-instruct
REPORT_LLM_OUTPUT_MODE=json_object
REPORT_LLM_TIMEOUT_SECONDS=60

# --- Academy Embedding Server (BGE-M3) ---
EMBEDDING_BASE_URL=http://llm-server:8000/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_SECONDS=120

# --- Academy BGE-Reranker Server ---
RERANK_BASE_URL=http://llm-server:8000
RERANK_API_KEY=EMPTY
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=120

# Knowledge Base Version
SERVICE_KNOWLEDGE_VERSION=1.0
