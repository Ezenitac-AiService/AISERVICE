# =================================================================
# A-Team Containerized Environment Configuration (SSOT)
# =================================================================
# Copy this file to .env and fill local secrets/endpoints.
# Never commit .env to Git.

# --- Gateway Forwarding & Prefixes ---
APPLICATION_ROOT=/ateam/pilos
SCRIPT_NAME=/ateam/pilos
FORWARDED_PREFIX=/ateam/pilos
PORT=5000

# --- Flask Web Application ---
FLASK_SECRET_KEY=__SET_IN_PROTECTED_SECRETS_FILE__

# --- MySQL Connection (Internal Docker Network: pilos-db:3306) ---
DB_HOST=pilos-db
DB_PORT=3306
DB_USER=pilos_user
DB_PASSWORD=__SET_IN_PROTECTED_SECRETS_FILE__
DB_NAME=pilos_v2
DB_ROOT_PASSWORD=__SET_IN_PROTECTED_SECRETS_FILE__

# --- De-identification Hashing Salts ---
SECRET_SALT=__SET_IN_PROTECTED_SECRETS_FILE__
SECRET_SALT2=__SET_IN_PROTECTED_SECRETS_FILE__

# --- Kiwoom Supply-Demand (Optional) ---
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_START_DATE=
KIWOOM_END_DATE=
SUPPLY_DEMAND_DB_WRITE_ENABLED=false

# --- Shared OpenAI-compatible LLM Connection (aiservice-network) ---
LLM_PROVIDER=openai
LLM_BASE_URL=http://vllm-serv-gateway:8081/v1
LLM_API_KEY=EMPTY

# Chatbot LLM
CHAT_LLM_MODEL=qwen3.5-4b
CHAT_LLM_TIMEOUT_SECONDS=180

# LLM Report Generation
REPORT_LLM_MODEL=qwen3.5-2b
REPORT_LLM_OUTPUT_MODE=json_object
REPORT_LLM_TIMEOUT_SECONDS=180

# --- Embedding Server (BGE-M3) ---
EMBEDDING_BASE_URL=http://vllm-serv-gateway:8090/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_SECONDS=180

# --- BGE-Reranker Server ---
RERANK_BASE_URL=http://vllm-serv-gateway:8091/v1
RERANK_API_KEY=EMPTY
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=180

# --- Pipeline Configuration ---
PIPELINE_INTERVAL_SECONDS=600
TZ=Asia/Seoul
